<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Descargar Violin Beach Kombat v1.4</title>
<style>
  :root{
    --bg:#0b1420;
    --panel:#0f1c31;
    --accent:#1f7aec;
    --text:#e8f2ff;
  }
  body{
    margin:0;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    background:radial-gradient(circle at 20% 20%, rgba(66,135,245,0.12), transparent 40%),
               radial-gradient(circle at 80% 70%, rgba(255,190,120,0.1), transparent 45%),
               var(--bg);
    color:var(--text);
    font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
  }
  .card{
    width:min(840px,94vw);
    background:var(--panel);
    border:1px solid #1f3050;
    border-radius:14px;
    padding:22px;
    box-shadow:0 20px 60px #000a, 0 0 0 1px #0c1727;
  }
  h1{margin:0 0 12px;font-size:22px;}
  p{margin:0 0 12px;line-height:1.5;color:#c8d9ff;}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin:8px 0 14px;}
  input, textarea, button{
    font:600 14px system-ui;
  }
  input{
    flex:1 1 300px;
    min-width:220px;
    padding:10px 12px;
    border-radius:10px;
    border:1px solid #1f3050;
    background:#0c1424;
    color:#d8e6ff;
  }
  textarea{
    width:100%;
    min-height:180px;
    max-height:400px;
    background:#0c1424;
    color:#d8e6ff;
    border:1px solid #1f3050;
    border-radius:10px;
    padding:10px;
    font:600 11px/1.35 monospace;
    resize:vertical;
  }
  button{
    border:none;
    border-radius:10px;
    padding:12px 16px;
    cursor:pointer;
    transition:transform .08s ease, box-shadow .12s ease, opacity .15s;
  }
  .primary{
    background:linear-gradient(135deg,#1f7aec,#10b2ff);
    color:#fff;
    box-shadow:0 10px 24px #0008;
  }
  .primary:hover{transform:translateY(-2px);}
  .secondary{
    background:#102238;
    color:#dce6ff;
    border:1px solid #274268;
  }
  .danger{
    background:#2a1212;
    color:#f7c5c5;
    border:1px solid #5b2020;
  }
  small{color:#9bb3d7;}
</style>
</head>
<body>
  <div class="card">
    <h1>Descargar Violin Beach Kombat (v1.4)</h1>
    <p>Opción 1: pega el enlace RAW de GitHub y descarga directo. Opción 2: pega el código completo abajo y descarga desde ahí. Como respaldo, haz clic en el cuadro para copiar todo.</p>
    <div class="row">
      <input type="url" id="urlInput" placeholder="https://raw.githubusercontent.com/USER/REPO/BRANCH/Violin_Beach_Kombat(v1.4).html" />
      <button class="primary" id="btnDownload">Descargar HTML</button>
      <button class="secondary" id="btnCopy">Copiar código</button>
      <button class="danger" id="btnClear">Limpiar</button>
    </div>
    <textarea id="codeBox" placeholder="Pega aquí el código completo de Violin_Beach_Kombat(v1.4).html"></textarea>
    <small>Precarga opcional sin comillas: pega el código entre las etiquetas <script type="text/plain" id="gameSource">...</script> al final de este archivo.</small>
  </div>

<!-- Opcional: pega aquí el código del juego para precargar sin escapar comillas -->
<script type="text/plain" id="gameSource">
</script>

<script>
const urlInput = document.getElementById('urlInput');
const codeBox = document.getElementById('codeBox');
const btnDownload = document.getElementById('btnDownload');
const btnCopy = document.getElementById('btnCopy');
const btnClear = document.getElementById('btnClear');

// Precarga desde el bloque text/plain si se llenó
const embedded = (document.getElementById('gameSource')?.textContent || '').trim();
if(embedded){
  codeBox.value = embedded;
}

function downloadBlob(text){
  const blob = new Blob([text], { type: 'text/html;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'Violin_Beach_Kombat(v1.4).html';
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

async function downloadFile(){
  const src = (urlInput.value || '').trim();
  if(src){
    try{
      const res = await fetch(src);
      if(!res.ok) throw new Error('HTTP ' + res.status);
      const text = await res.text();
      downloadBlob(text);
      return;
    }catch(err){
      alert('No se pudo descargar desde la URL. Se intentará usar el texto del cuadro.\n' + err);
    }
  }
  if(!codeBox.value.trim()){
    alert('Pega el código del juego o coloca un enlace RAW de GitHub.');
    return;
  }
  downloadBlob(codeBox.value);
}

async function copyCode(){
  try{
    codeBox.select();
    codeBox.setSelectionRange(0, codeBox.value.length);
    await navigator.clipboard.writeText(codeBox.value);
  }catch(e){
    // deja seleccionado como fallback
  }
}

function clearAll(){
  urlInput.value = '';
  codeBox.value = '';
}

btnDownload.addEventListener('click', downloadFile);
btnCopy.addEventListener('click', copyCode);
btnClear.addEventListener('click', clearAll);
codeBox.addEventListener('click', copyCode);
</script>
</body>
</html>
